# App 1 — Audit Web Passif : clés API optionnelles
# Copier ce fichier en `.env` et renseigner les clés disponibles.
# Toutes les clés sont facultatives : sans elles, les modules concernés
# fonctionnent en mode dégradé (sans échec).

# Google Safe Browsing (clé Google Cloud gratuite) — Module B
SAFE_BROWSING_API_KEY=

# VirusTotal (quota gratuit) — Module B
VIRUSTOTAL_API_KEY=

# NVD / National Vulnerability Database (clé gratuite, augmente le quota) — Module C
NVD_API_KEY=

# Chemin d'un Chrome/Chromium pour Puppeteer (optionnel)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
