# App 1 — Audit Web Passif : clés API optionnelles
# Copier ce fichier en `.env` et renseigner les clés disponibles.
# Toutes les clés sont facultatives : sans elles, les modules concernés
# fonctionnent en mode dégradé (sans échec).

# Google Safe Browsing (clé Google Cloud gratuite) — Module B
SAFE_BROWSING_API_KEY=

# VirusTotal (quota gratuit) — Module B
VIRUSTOTAL_API_KEY=

# NVD / National Vulnerability Database (clé gratuite, augmente le quota) — Module C
NVD_API_KEY=

# Chemin d'un Chrome/Chromium pour Puppeteer (optionnel)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Interface web / self-service ---
# Port du serveur web (défaut 3000)
PORT=3000
# URL publique du service (pour les redirections Stripe)
PUBLIC_BASE_URL=http://localhost:3000
# Dossier de stockage des comptes (défaut : ./data)
# AUDIT_DATA_DIR=./data

# --- Paiement Stripe (self-service : PAIEMENT UNIQUE -> accès à vie) ---
# Sans ces clés, l'activation manuelle via `node src/admin.js activate` reste possible.
# STRIPE_PRICE_ID doit être un tarif "one-time" (paiement unique), pas un abonnement.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
