      "cookies": ["PrestaShop-"]
    },
    {
      "name": "Shopify",
      "category": "E-commerce (SaaS)",
      "headers": { "x-shopify-stage": "", "x-sorting-hat-shopid": "" },
      "html": ["cdn.shopify.com", "Shopify.theme"]
    },
    {
      "name": "Wix",
      "category": "CMS (SaaS)",
      "headers": { "x-wix-request-id": "" },
      "html": ["static.wixstatic.com"]
    },
    {
      "name": "Squarespace",
      "category": "CMS (SaaS)",
      "headers": { "server": "Squarespace" },
      "html": ["static1.squarespace.com"]
    },
    {
      "name": "Ghost",
      "category": "CMS",
      "cpe": "cpe:2.3:a:ghost:ghost",
      "meta": { "generator": "Ghost ?([\\d.]+)?" }
    },

    { "_section": "== Bibliothèques / frameworks front ==" },
    {
      "name": "jQuery",
      "category": "Bibliothèque JavaScript",
      "cpe": "cpe:2.3:a:jquery:jquery",
      "html": ["jquery-?([\\d.]+)?(\\.min)?\\.js", "jquery/([\\d.]+)/", "jQuery v([\\d.]+)"]
    },
    {
      "name": "Bootstrap",
      "category": "Framework UI",
      "cpe": "cpe:2.3:a:getbootstrap:bootstrap",
      "html": ["bootstrap-?([\\d.]+)?(\\.min)?\\.css", "bootstrap/([\\d.]+)/"]
    },
    {
      "name": "React",
      "category": "Framework JavaScript",
      "cpe": "cpe:2.3:a:facebook:react",
      "html": ["data-reactroot", "react-dom", "_reactListening"]
    },
    {
      "name": "Vue.js",
      "category": "Framework JavaScript",
      "cpe": "cpe:2.3:a:vuejs:vue",
      "html": ["data-v-", "vue(\\.min)?\\.js", "__vue__"]
    },
    {
      "name": "Angular",
      "category": "Framework JavaScript",
      "cpe": "cpe:2.3:a:angular:angular",
      "html": ["ng-version=\"([\\d.]+)\"", "ng-app", "angular(\\.min)?\\.js"]
    },

    { "_section": "== CDN / WAF ==" },
    {
      "name": "Cloudflare",
