{
  "_comment": "Base de signatures technologiques (format inspiré de Wappalyzer, open source). Détection par en-têtes HTTP, cookies, balises meta et motifs HTML/JS. Les regex 'version' capturent le numéro de version dans le groupe 1. Base data-driven : ajouter une techno = ajouter une entrée ici, sans toucher au code. Couvre volontairement plusieurs langages (PHP, Node, Python, Ruby, Java, .NET) car les sites n'utilisent pas tous le même.",

  "technologies": [

    { "_section": "== Serveurs web ==" },
    {
      "name": "Nginx",
      "category": "Serveur web",
      "cpe": "cpe:2.3:a:nginx:nginx",
      "headers": { "server": "nginx/?([\\d.]+)?" }
    },
    {
      "name": "Apache httpd",
      "category": "Serveur web",
      "cpe": "cpe:2.3:a:apache:http_server",
      "headers": { "server": "Apache/?([\\d.]+)?" }
    },
    {
      "name": "Microsoft IIS",
      "category": "Serveur web",
      "cpe": "cpe:2.3:a:microsoft:internet_information_services",
      "headers": { "server": "Microsoft-IIS/?([\\d.]+)?" }
    },
    {
      "name": "LiteSpeed",
      "category": "Serveur web",
      "cpe": "cpe:2.3:a:litespeedtech:litespeed_web_server",
      "headers": { "server": "LiteSpeed" }
    },
    {
      "name": "Apache Tomcat",
      "category": "Serveur applicatif (Java)",
      "cpe": "cpe:2.3:a:apache:tomcat",
      "headers": { "server": "Apache-Coyote", "x-powered-by": "(?:Servlet|JSP)" }
    },
    {
      "name": "Caddy",
      "category": "Serveur web",
      "headers": { "server": "Caddy" }
    },
    {
      "name": "Kestrel (ASP.NET Core)",
      "category": "Serveur applicatif (.NET)",
      "headers": { "server": "Kestrel" }
    },
    {
      "name": "Gunicorn",
      "category": "Serveur applicatif (Python)",
      "headers": { "server": "gunicorn/?([\\d.]+)?" }
    },
    {
      "name": "Werkzeug (Flask)",
      "category": "Serveur applicatif (Python)",
      "headers": { "server": "Werkzeug/?([\\d.]+)?" }
    },

    { "_section": "== Langages / runtimes ==" },
    {
      "name": "PHP",
      "category": "Langage",
      "cpe": "cpe:2.3:a:php:php",
      "headers": { "x-powered-by": "PHP/?([\\d.]+)?" },
      "cookies": ["PHPSESSID"]
    },
    {
      "name": "ASP.NET",
      "category": "Framework (.NET)",
      "cpe": "cpe:2.3:a:microsoft:asp.net",
      "headers": { "x-powered-by": "ASP\\.NET", "x-aspnet-version": "([\\d.]+)" },
      "cookies": ["ASP.NET_SessionId"]
    },
    {
      "name": "Node.js",
      "category": "Runtime",
      "cpe": "cpe:2.3:a:nodejs:node.js",
      "headers": { "x-powered-by": "Express|Next\\.js|Nuxt" }
    },
    {
      "name": "Java (JSESSIONID)",
      "category": "Langage",
      "cookies": ["JSESSIONID"]
    },
    {
      "name": "Python",
      "category": "Langage",
      "headers": { "server": "Werkzeug|gunicorn|Python" }
    },

    { "_section": "== Frameworks web ==" },
    {
      "name": "Express",
      "category": "Framework (Node.js)",
      "cpe": "cpe:2.3:a:openjsf:express",
      "headers": { "x-powered-by": "Express" }
    },
    {
      "name": "Next.js",
      "category": "Framework (Node.js)",
      "cpe": "cpe:2.3:a:vercel:next.js",
      "headers": { "x-powered-by": "Next\\.js", "x-nextjs-cache": "" },
      "html": ["/_next/static/", "__NEXT_DATA__"]
    },
    {
      "name": "Nuxt.js",
      "category": "Framework (Node.js)",
      "headers": { "x-powered-by": "Nuxt" },
      "html": ["/_nuxt/", "__NUXT__"]
    },
    {
      "name": "Laravel",
      "category": "Framework (PHP)",
      "cpe": "cpe:2.3:a:laravel:laravel",
      "cookies": ["laravel_session", "XSRF-TOKEN"]
    },
    {
      "name": "Symfony",
      "category": "Framework (PHP)",
      "cpe": "cpe:2.3:a:sensiolabs:symfony",
      "headers": { "x-debug-token-link": "" },
      "cookies": ["symfony"]
    },
    {
      "name": "CodeIgniter",
      "category": "Framework (PHP)",
      "cpe": "cpe:2.3:a:codeigniter:codeigniter",
      "cookies": ["ci_session"]
    },
    {
      "name": "Django",
      "category": "Framework (Python)",
      "cpe": "cpe:2.3:a:djangoproject:django",
      "cookies": ["csrftoken", "django_language"]
    },
    {
      "name": "Flask",
      "category": "Framework (Python)",
      "headers": { "server": "Werkzeug" }
    },
    {
      "name": "Ruby on Rails",
      "category": "Framework (Ruby)",
      "cpe": "cpe:2.3:a:rubyonrails:rails",
      "headers": { "x-powered-by": "Phusion Passenger", "x-runtime": "" },
      "cookies": ["_rails", "_session_id"]
    },
    {
      "name": "Spring",
      "category": "Framework (Java)",
      "cpe": "cpe:2.3:a:vmware:spring_framework",
      "headers": { "x-application-context": "" }
    },

    { "_section": "== CMS / e-commerce ==" },
    {
      "name": "WordPress",
      "category": "CMS",
      "cpe": "cpe:2.3:a:wordpress:wordpress",
      "meta": { "generator": "WordPress ?([\\d.]+)?" },
      "html": ["wp-content/", "wp-includes/"],
      "cookies": ["wordpress_", "wp-settings-"]
    },
    {
      "name": "Drupal",
      "category": "CMS",
      "cpe": "cpe:2.3:a:drupal:drupal",
      "headers": { "x-generator": "Drupal ?([\\d.]+)?", "x-drupal-cache": "", "x-drupal-dynamic-cache": "" },
      "meta": { "generator": "Drupal ?([\\d.]+)?" },
      "html": ["sites/all/", "/sites/default/files"]
    },
    {
      "name": "Joomla",
      "category": "CMS",
      "cpe": "cpe:2.3:a:joomla:joomla",
      "meta": { "generator": "Joomla!? ?([\\d.]+)?" },
      "html": ["/media/jui/", "com_content"]
    },
    {
      "name": "TYPO3",
      "category": "CMS",
      "cpe": "cpe:2.3:a:typo3:typo3",
      "meta": { "generator": "TYPO3 ?([\\d.]+)?" },
      "html": ["/typo3temp/", "/typo3conf/"]
    },
    {
      "name": "Magento",
      "category": "E-commerce",
      "cpe": "cpe:2.3:a:magento:magento",
      "cookies": ["X-Magento-", "mage-"],
